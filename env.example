# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Application Configuration
APP_NAME=FastAPI App
ENVIRONMENT=development
DEBUG=true

# API Configuration
API_PREFIX=/api/v1

# Bearer token required for protected endpoints (e.g. `openssl rand -hex 32`).
# Must be non-empty: the app refuses to start with a blank token.
API_TOKEN=

# CORS allowed origins (comma-separated). Credentials are enabled, so "*" is
# not valid — list the real browser origins in production.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000 
